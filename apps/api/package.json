{
  "name": "@velora/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist-worker",
    "cf:types": "wrangler types src/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply velora-local --local --env local",
    "db:migrate:preview": "wrangler d1 migrations apply velora-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply velora-production --remote --env=\"\""
  },
  "dependencies": {
    "@velora/ai": "workspace:*",
    "@velora/billing": "workspace:*",
    "@velora/config": "workspace:*",
    "@velora/domain": "workspace:*",
    "@velora/memory": "workspace:*",
    "@velora/moderation": "workspace:*",
    "@velora/prompts": "workspace:*",
    "@velora/shared": "workspace:*",
    "hono": "4.13.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260809.1",
    "wrangler": "4.120.0"
  }
}
