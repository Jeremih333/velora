{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "velora-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/ready",
      "/openapi.json",
      "/telegram/*",
      "/__scheduled",
    ],
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Velora",
    "TELEGRAM_BOT_USERNAME": "aivel0ra_bot",
    "PUBLIC_APP_URL": "https://velora-app.carreljeremih.workers.dev",
    "MAX_INIT_DATA_AGE_SECONDS": "900",
    "DAILY_AI_BUDGET_USD": "0.80",
    "MONTHLY_AI_BUDGET_USD": "24",
    "LIFETIME_AI_BUDGET_USD": "350",
    "PAID_AI_ENABLED": "false",
    "PAYMENTS_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "velora-production",
      "database_id": "aa0f89b4-2ba7-4717-9d24-36ce49bf3897",
      "migrations_dir": "../../migrations",
    },
  ],
  "env": {
    "staging": {
      "name": "velora-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_NAME": "Velora",
        "TELEGRAM_BOT_USERNAME": "aivel0ra_bot",
        "OWNER_TELEGRAM_ID": "1040929628",
        "PUBLIC_APP_URL": "https://velora-staging.carreljeremih.workers.dev",
        "MAX_INIT_DATA_AGE_SECONDS": "900",
        "DAILY_AI_BUDGET_USD": "0.10",
        "MONTHLY_AI_BUDGET_USD": "1",
        "LIFETIME_AI_BUDGET_USD": "5",
        "PAID_AI_ENABLED": "false",
        "PAYMENTS_ENABLED": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "velora-staging",
          "database_id": "1069c0c8-ec14-441e-a208-dfe64e494b26",
          "migrations_dir": "../../migrations",
        },
      ],
    },
    "local": {
      "name": "velora-local",
      "vars": {
        "ENVIRONMENT": "local",
        "APP_NAME": "Velora",
        "TELEGRAM_BOT_USERNAME": "velora_local_bot",
        "PUBLIC_APP_URL": "http://127.0.0.1:8787",
        "MAX_INIT_DATA_AGE_SECONDS": "900",
        "DAILY_AI_BUDGET_USD": "0.01",
        "MONTHLY_AI_BUDGET_USD": "0.01",
        "LIFETIME_AI_BUDGET_USD": "0.01",
        "PAID_AI_ENABLED": "false",
        "PAYMENTS_ENABLED": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "velora-local",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../migrations",
        },
      ],
    },
  },
}
